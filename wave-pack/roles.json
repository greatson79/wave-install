{
  "schema": "wave-pack.roles.v1",
  "_doc": "초기 편성 확인 = master 표지 + cso·worker 생존(420초). 실제 소환·지침은 앱 원본 팩이 담당하며 리뷰어는 기다리지 않는다. 이 파일은 설치기 호환 메타데이터다.",
  "roles": [
    {
      "role": "master",
      "kind": "master",
      "title": "마스터 비서",
      "engine": "claude",
      "cwd": "${WAVE_HOME}/hq",
      "directive": "directives/MASTER_DIRECTIVE.md",
      "budget_kb": 12
    },
    {
      "role": "cso",
      "kind": "cso",
      "title": "운영 관리",
      "engine": "claude",
      "cwd": "${WAVE_HOME}/hq",
      "directive": "directives/CSO_DIRECTIVE.md"
    },
    {
      "role": "worker",
      "kind": "worker",
      "title": "작업 워커",
      "engine": "claude",
      "cwd": "${WAVE_HOME}/hq",
      "directive": "directives/WORKER_DIRECTIVE.md",
      "budget_kb": 16
    }
  ],
  "review": {
    "mode": "headless",
    "tool": "bin/review-headless",
    "engine": "claude -p",
    "rule": "author_ne_reviewer"
  },
  "defaults": {
    "WAVE_HOME": "~/wave",
    "WAVE_DEPT_DIR": "~/wave/my-ai-hq"
  }
}
