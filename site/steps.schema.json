{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waveainetworks.com/schemas/wave-install-steps-v1.json",
  "title": "Wave Install Steps v1",
  "type": "object",
  "required": ["schema_version", "total", "steps"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "total": { "type": "integer", "const": 10 },
    "steps": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "command", "pass_conditions", "failure_guidance"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 9 },
          "title": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "pass_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "failure_guidance": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
