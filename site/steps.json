{
  "schema": "wave-install.steps.v1",
  "product": "Wave Terminal",
  "version": "0.2.3",
  "platforms": ["macos", "windows"],
  "release": {
    "repository": "greatson79/wave-terminal",
    "macos_version": "0.1.1",
    "version": "0.1.0",
    "asset_name": {
      "macos_arm64": "wave-terminal-0.1.1-macos-arm64.dmg",
      "macos_x64": "wave-terminal-0.1.1-macos-x64.dmg",
      "windows_x64": "wave-terminal-0.1.0-windows-x64-setup.exe"
    },
    "asset_url": {
      "macos_arm64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.1/wave-terminal-0.1.1-macos-arm64.dmg",
      "macos_x64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.1/wave-terminal-0.1.1-macos-x64.dmg",
      "windows_x64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/wave-terminal-0.1.0-windows-x64-setup.exe"
    },
    "sha256": {
      "macos_arm64": "c46aac889c1dfb84827a580f83cb2098eceba30c85b98c961dd74cff6fc0cadc",
      "macos_x64": "aaee7fb8745e16e02e64f95bb698e7695742e7db906fdf1a53c99d88134cbf48",
      "windows_x64": "733a595c1270d62e9ca83e82cda143d8ec223985b857f648939541d20ba12fc3"
    },
    "sha256sums_url": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/SHA256SUMS",
    "windows_sha256sums_url": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/SHA256SUMS",
    "windows_publisher_subject": "",
    "minisig_url": {
      "macos_arm64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/wave-terminal-0.1.0-macos-arm64.dmg.minisig",
      "macos_x64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/wave-terminal-0.1.0-macos-x64.dmg.minisig",
      "windows_x64": "https://github.com/greatson79/wave-terminal/releases/download/v0.1.0/wave-terminal-0.1.0-windows-x64-setup.exe.minisig"
    },
    "minisign_public_key": "RWShBLhu6xe+AnzdLhOKUuXyZb6FPjuBSWG0s7SPacy3v9o4Qt8Y9mqI",
    "cdhash": {
      "macos_arm64": "86bdbce54748b3fabeecd4cfa22a73648867e23d",
      "macos_x64": "2bdc189e25310de485de8639412b96e9aa68280b"
    }
  },
  "tooling": {
    "claude_code_version": "2.1.278",
    "claude_code_min_version": "2.1.278",
    "min_free_bytes": 5368709120,
    "max_injected_bytes_per_seat": 20480
  },
  "steps": [
    {
      "id": "S00_PREFLIGHT",
      "index": 0,
      "total": 10,
      "title": "OS·셸·디스크·권한 검사",
      "command": {
        "macos": "uname -s; command -v zsh; df -Pk \"$HOME\"; test -w \"$HOME\"",
        "windows": "[Environment]::OSVersion; $PSVersionTable.PSVersion; Get-PSDrive -Name C; Test-Path -PathType Container $env:USERPROFILE"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave"}
      ],
      "on_fail": {
        "error_id": "WT-S00-PREFLIGHT",
        "message": "관리자 권한 없이 사용자 폴더·필수 셸·디스크 여유 공간을 확인하지 못했습니다.",
        "next": "stop"
      },
      "optional": false
    },
    {
      "id": "S01_CLAUDE_INSTALL",
      "index": 1,
      "total": 10,
      "title": "Claude Code 설치·최소 버전 확인(없으면 설치, 낮으면 claude update)",
      "command": {
        "macos": "command -v claude || curl -fsSL https://claude.ai/install.sh | bash; claude --version; claude update (낮을 때만)",
        "windows": "Get-Command claude -ErrorAction SilentlyContinue; if (-not $?) { Invoke-WebRequest https://claude.ai/install.ps1 }; claude --version; claude update (낮을 때만)"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/tooling/claude.version"},
        {"kind": "non_placeholder", "path": "~/.wave/tooling/claude.version"}
      ],
      "on_fail": {
        "error_id": "WT-S01-CLAUDE",
        "message": "Claude Code 2.1.278 이상이 필요합니다. macOS 설치기는 설치·claude update를 대신 실행하며, 그래도 안 되면 터미널에서 claude update를 직접 실행한 뒤 다시 실행하세요.",
        "next": "retry"
      },
      "optional": false
    },
    {
      "id": "S02_CLAUDE_LOGIN",
      "index": 2,
      "total": 10,
      "title": "Claude 로그인(안 되어 있으면 설치 창에서 진행)",
      "command": {
        "macos": "claude auth status || claude auth login",
        "windows": "claude auth status; claude auth login (미로그인 때만); claude auth status"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/auth/claude-authenticated"}
      ],
      "on_fail": {
        "error_id": "WT-S02-AUTH",
        "message": "Claude 로그인 상태를 확인하지 못했습니다. 토큰·계정값은 기록하지 않고 로그인 절차만 다시 안내합니다.",
        "next": "retry"
      },
      "optional": false
    },
    {
      "id": "S03_DOWNLOAD_VERIFY",
      "index": 3,
      "total": 10,
      "title": "Wave Terminal 내려받기·지문(SHA256)·서명 확인",
      "command": {
        "macos": "curl -fL <asset-url> -o <artifact> && shasum -a 256 <artifact> (고정값 대조) && codesign --verify --deep --strict <앱>",
        "windows": "Invoke-WebRequest <asset-url> -OutFile <artifact>; Get-FileHash <artifact> -Algorithm SHA256; Get-AuthenticodeSignature <artifact>"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/downloads/wave-terminal-artifact"},
        {"kind": "sha256", "path": "~/.wave/downloads/wave-terminal-artifact", "source": "SHA256SUMS"}
      ],
      "on_fail": {
        "error_id": "WT-S03-VERIFY",
        "message": "릴리스 URL·고정 SHA256이 확정되지 않았거나 SHA256·codesign 검증에 실패했습니다. 설치를 중단합니다.",
        "next": "stop"
      },
      "optional": false
    },
    {
      "id": "S04_INSTALL_LINK",
      "index": 4,
      "total": 10,
      "title": "사용자 폴더 설치·cys/cysd 셸 연결",
      "command": {
        "macos": "~/.wave/bin/cys --version && test -f ~/.wave/bin/cysd && test -x ~/.wave/bin/cysd && test -L ~/.wave/bin/cysd && readlink ~/.wave/bin/cysd && zsh -lc 'command -v cys'",
        "windows": "$env:USERPROFILE\\.wave\\bin\\cys.exe --version; $env:USERPROFILE\\.wave\\bin\\cysd.exe --version"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/bin/cys"},
        {"kind": "file_exists", "path": "~/.wave/bin/cysd"}
      ],
      "on_fail": {
        "error_id": "WT-S04-LINK",
        "message": "사용자 폴더 설치 또는 cys/cysd 셸 연결을 실측하지 못했습니다.",
        "next": "retry"
      },
      "optional": false
    },
    {
      "id": "S05_DAEMON_REGISTER",
      "index": 5,
      "total": 10,
      "title": "데몬 등록(선택·기본 on)",
      "command": {
        "macos": "launchctl bootstrap gui/$(id -u) ~/.wave/installer/daemon/com.waveainetworks.cysd.plist && launchctl print gui/$(id -u)/com.waveainetworks.cysd",
        "windows": "HKCU Run: WaveTerminal-cysd = quoted user cysd.exe path; read back exact value"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/installer/daemon/register-result"}
      ],
      "on_fail": {
        "error_id": "WT-S05-DAEMON",
        "message": "데몬 등록 결과를 확인하지 못했습니다. 선택을 해제했는지 또는 사용자 권한 오류인지 확인하세요.",
        "next": "retry"
      },
      "optional": true
    },
    {
      "id": "S06_PACK_INSTALL",
      "index": 6,
      "total": 10,
      "title": "wave-pack 배치·manifest/SHA256 검증",
      "command": {
        "macos": "cp -R wave-pack/. ~/.cys/pack/ && (cd ~/.cys/pack && shasum -a 256 -c SHA256SUMS)",
        "windows": "Copy-Item wave-pack\\* $env:USERPROFILE\\.cys\\pack -Recurse -Force; Get-FileHash .\\manifest.json -Algorithm SHA256"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.cys/pack/manifest.json"},
        {"kind": "file_exists", "path": "~/.cys/pack/SHA256SUMS"}
      ],
      "on_fail": {
        "error_id": "WT-S06-PACK",
        "message": "wave-pack이 없거나 manifest/SHA256 검증을 통과하지 못했습니다.",
        "next": "stop"
      },
      "optional": false
    },
    {
      "id": "S07_INITIAL_FLEET",
      "index": 7,
      "total": 10,
      "title": "초기 편성 정의 확인(마스터 1+부서 1 · 기동 미검증)",
      "command": {
        "macos": "~/.wave/bin/wave fleet bootstrap --roles-file ~/.cys/pack/roles.json",
        "windows": "$env:USERPROFILE\\.wave\\bin\\wave.ps1 fleet bootstrap --roles-file $env:USERPROFILE\\.cys\\pack\\roles.json"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/fleet/initial-fleet.ok"},
        {"kind": "count", "path": "~/.wave/fleet/status.json", "json_path": "seats", "equals": 2, "message": "좌석 수 2 확인 · roles.json 기준, 실제 기동 미검증"}
      ],
      "on_fail": {
        "error_id": "WT-S07-FLEET",
        "message": "roles.json 기준 마스터 1+부서 1 편성을 2석으로 확인하지 못했습니다.",
        "next": "stop"
      },
      "optional": false
    },
    {
      "id": "S08_VERIFY",
      "index": 8,
      "total": 10,
      "title": "identify·좌석 수 2 확인 · 주입량 미측정(후속)",
      "command": {
        "macos": "~/.wave/bin/cys identify && ~/.wave/bin/wave doctor --json",
        "windows": "$env:USERPROFILE\\.wave\\bin\\cys.exe identify; $env:USERPROFILE\\.wave\\bin\\wave.ps1 doctor --json"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "json_path", "path": "~/.wave/verify/doctor.json", "json_path": "identify_exit", "equals": 0},
        {"kind": "count", "path": "~/.wave/verify/doctor.json", "json_path": "seats", "equals": 2},
        {"kind": "bytes_lte", "path": "~/.wave/verify/doctor.json", "json_path": "max_injected_bytes", "max": 20480, "message": "주입량 — 미측정(후속) · 측정 시 기준 20KB 이하"}
      ],
      "on_fail": {
        "error_id": "WT-S08-VERIFY",
        "message": "identify·좌석 수 확인 실패 또는 실측 주입량 초과 시 중단합니다. 주입량 미측정은 예외에 기록하고 진행합니다.",
        "next": "stop"
      },
      "optional": false
    },
    {
      "id": "S09_COMPLETE",
      "index": 9,
      "total": 10,
      "title": "절차 종료·예외 요약·START-HERE 안내",
      "command": {
        "macos": "test -f ~/.wave/START-HERE.md && cat ~/.wave/START-HERE.md",
        "windows": "Test-Path $env:USERPROFILE\\.wave\\START-HERE.md; Get-Content $env:USERPROFILE\\.wave\\START-HERE.md"
      },
      "pass": [
        {"kind": "exit_code", "equals": 0},
        {"kind": "file_exists", "path": "~/.wave/START-HERE.md"},
        {"kind": "json_path", "path": "~/.wave/install-state.json", "json_path": "required_steps_passed", "equals": true, "message": "전체 검증 시 true · 예외·미측정이 있으면 false와 exceptions 기록"}
      ],
      "on_fail": {
        "error_id": "WT-S09-COMPLETE",
        "message": "상태 저장 또는 START-HERE 안내 생성에 실패했습니다. 미측정·건너뜀은 complete_with_exceptions로 기록합니다.",
        "next": "stop"
      },
      "optional": false
    }
  ]
}
